# PostgreSQL database password
DB_PASSWORD=your_postgres_password_here

# JWT signing secret - use a long, random string (min 32 characters)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Optional: default admin account seeded on first startup (skipped once any ADMIN exists).
# Override these before deploying anywhere real - defaults are for local/demo use only.
# ADMIN_BOOTSTRAP_ENABLED=true
# ADMIN_BOOTSTRAP_NATIONAL_ID=00000000000
# ADMIN_BOOTSTRAP_EMAIL=admin@evergreenbank.local
# ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!